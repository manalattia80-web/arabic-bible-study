# ============================================================
# Supabase Credentials
# Get these from: Supabase Dashboard → Settings → API
# ============================================================

# Your Supabase project URL (e.g. https://xyzabc.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase SERVICE ROLE key (has full DB access — keep secret!)
# Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================
# Data file paths (relative to the scripts/ directory)
# ============================================================

# Path to the AVD USFM files directory (downloaded from ebible.org/ara)
# Expected: one .usfm file per book (e.g. GEN.usfm, EXO.usfm, ...)
AVD_USFM_DIR=./data/avd

# Path to STEPBible TAHOT TSV file (Hebrew OT with Strong's numbers)
# Download from: github.com/STEPBible/STEPBible-Data → TAHOT
TAHOT_TSV_PATH=./data/hebrew/TAHOT.tsv

# Path to STEPBible TAGNT TSV file (Greek NT with Strong's numbers)
# Download from: github.com/STEPBible/STEPBible-Data → TAGNT
TAGNT_TSV_PATH=./data/greek/TAGNT.tsv

# ============================================================
# Import options
# ============================================================

# Batch size for database inserts (increase on fast connections)
BATCH_SIZE=100

# Set to 'true' to skip rows that already exist (safe re-run)
UPSERT_MODE=true
