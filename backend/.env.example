# ============================================================
# Supabase Credentials
# Dashboard → Settings → API
# ============================================================

SUPABASE_URL=https://your-project-id.supabase.co

# Use SERVICE ROLE key for the backend (bypasses RLS on admin routes)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================
# JWT Secret (generate a strong random string — min 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================
JWT_SECRET=replace-with-a-long-random-secret-string

# Token expiry (e.g. 8h, 1d, 7d)
JWT_EXPIRY=8h

# ============================================================
# Redis Cache (Upstash — optional but recommended)
# Dashboard → Upstash Console → REST API URL + Token
# Leave blank to disable caching
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================================
# Server Config
# ============================================================
PORT=3001
HOST=0.0.0.0

# 'development' | 'production'
NODE_ENV=development

# ============================================================
# Supabase Storage
# Bucket name for audio files (create in Dashboard → Storage)
# ============================================================
AUDIO_BUCKET=bible-audio
