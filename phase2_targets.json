  "punctTokens": [
    {
      "id": "53c937ba-6fa8-4169-b558-d1d5e8306273",
      "verse_id": "11111111-0000-0000-0004-000000035006",
      "book_id": 4,
      "book_name": "العدد",
      "chapter_num": 35,
      "verse_num": 6,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "וְאֵ֣ת הֶֽעָרִ֗ים אֲשֶׁ֤ר תִּתְּנוּ֙ לַלְוִיִּ֔ם אֵ֚ת שֵׁשׁ־עָרֵ֣י הַמִּקְלָ֔ט אֲשֶׁ֣ר תִּתְּנ֔וּ לָנֻ֥ס שָׁ֖מָּה הָרֹצֵ֑חַ וַעֲלֵיהֶ֣ם תִּתְּנ֔וּ אַרְבָּעִ֥ים וּשְׁתַּ֖יִם עִֽיר׃"
    },
    {
      "id": "43055c7a-8864-4257-acc4-dc7c6f4b4ff1",
      "verse_id": "11111111-0000-0000-0019-000000073011",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 73,
      "verse_num": 11,
      "ar_word_position": 9,
      "ar_word": "»",
      "text_original": "וְֽאָמְר֗וּ אֵיכָ֥ה יָדַֽע אֵ֑ל וְיֵ֖שׁ דֵּעָ֣ה בְעֶלְיֽוֹן׃"
    },
    {
      "id": "53735646-578f-46f1-95ab-96b811b2553b",
      "verse_id": "11111111-0000-0000-0019-000000078012",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 78,
      "verse_num": 12,
      "ar_word_position": 8,
      "ar_word": "،",
      "text_original": "נֶ֣גֶד אֲ֭בוֹתָם עָ֣שָׂה פֶ֑לֶא בְּאֶ֖רֶץ מִצְרַ֣יִם שְׂדֵה צֹֽעַן׃"
    },
    {
      "id": "61633d0b-2a69-4bac-a2b0-c4913de26d79",
      "verse_id": "11111111-0000-0000-0019-000000079010",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 79,
      "verse_num": 10,
      "ar_word_position": 7,
      "ar_word": "».",
      "text_original": "לָ֤מָּה יֹאמְר֣וּ הַגּוֹיִם֮ אַיֵּ֪ה אֱֽלֹהֵ֫יהֶ֥ם יִוָּדַ֣ע בגייםבגייםבַּגּוֹיִ֣םלְעֵינֵ֑ינוּ נִ֝קְמַ֗ת דַּֽם עֲבָדֶ֥יךָ הַשָּׁפֽוּךְ׃"
    },
    {
      "id": "be161d05-a19c-4558-9eb3-0758f28df879",
      "verse_id": "11111111-0000-0000-0019-000000089008",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 89,
      "verse_num": 8,
      "ar_word_position": 7,
      "ar_word": "؟",
      "text_original": "יְהוָ֤ה אֱלֹ֘הֵ֤י צְבָא֗וֹת מִֽי כָֽמ֖וֹךָ חֲסִ֥ין יָ֑הּ וֶ֝אֱמֽוּנָתְךָ֗ סְבִיבוֹתֶֽיךָ׃"
    },
    {
      "id": "c6a02d68-dab7-405b-a9d7-56e4b38f7435",
      "verse_id": "11111111-0000-0000-0019-000000104034",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 104,
      "verse_num": 34,
      "ar_word_position": 4,
      "ar_word": "،",
      "text_original": "יֶעֱרַ֣ב עָלָ֣יו שִׂיחִ֑י אָ֝נֹכִ֗י אֶשְׂמַ֥ח בַּיהוָֽה׃"
    },
    {
      "id": "6da9934a-6040-4c01-9663-b598d2d94af5",
      "verse_id": "11111111-0000-0000-0019-000000113005",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 113,
      "verse_num": 5,
      "ar_word_position": 8,
      "ar_word": "؟",
      "text_original": "מִ֭י כַּיהוָ֣ה אֱלֹהֵ֑ינוּ הַֽמַּגְבִּיהִ֥י לָשָֽׁבֶת׃"
    },
    {
      "id": "a2f79f09-8fad-4aa1-8222-5821847fa7a4",
      "verse_id": "11111111-0000-0000-0019-000000114005",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 114,
      "verse_num": 5,
      "ar_word_position": 7,
      "ar_word": "؟",
      "text_original": "מַה לְּךָ֣ הַ֭יָּם כִּ֣י תָנ֑וּס הַ֝יַּרְדֵּ֗ן תִּסֹּ֥ב לְאָחֽוֹר׃"
    },
    {
      "id": "af1c1e3b-335f-4b0d-8a5a-2233e308e2f9",
      "verse_id": "11111111-0000-0000-0019-000000114005",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 114,
      "verse_num": 5,
      "ar_word_position": 16,
      "ar_word": "؟",
      "text_original": "מַה לְּךָ֣ הַ֭יָּם כִּ֣י תָנ֑וּס הַ֝יַּרְדֵּ֗ן תִּסֹּ֥ב לְאָחֽוֹר׃"
    },
    {
      "id": "461e2bcc-5970-4018-98e4-10dbd639015b",
      "verse_id": "11111111-0000-0000-0019-000000115002",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 115,
      "verse_num": 2,
      "ar_word_position": 7,
      "ar_word": "».",
      "text_original": "לָ֭מָּה יֹאמְר֣וּ הַגּוֹיִ֑ם אַיֵּה נָ֝֗א אֱלֹהֵיהֶֽם׃"
    },
    {
      "id": "1602bc93-3e08-46f8-9666-9093796be441",
      "verse_id": "11111111-0000-0000-0019-000000119082",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 119,
      "verse_num": 82,
      "ar_word_position": 10,
      "ar_word": "».",
      "text_original": "כָּל֣וּ עֵ֭ינַי לְאִמְרָתֶ֑ךָ לֵ֝אמֹ֗ר מָתַ֥י תְּֽנַחֲמֵֽנִי׃"
    },
    {
      "id": "65fec731-9da3-4a33-bac6-bc27ee41e09d",
      "verse_id": "11111111-0000-0000-0019-000000119176",
      "book_id": 19,
      "book_name": "المزامير",
      "chapter_num": 119,
      "verse_num": 176,
      "ar_word_position": 2,
      "ar_word": "،",
      "text_original": "תָּעִ֗יתִי כְּשֶׂ֣ה אֹ֭בֵד בַּקֵּ֣שׁ עַבְדֶּ֑ךָ כִּ֥י מִ֝צְוֺתֶ֗יךָ לֹ֣א שָׁכָֽחְתִּי׃"
    },
    {
      "id": "7458b019-405d-4148-8a4e-fb127d5c8205",
      "verse_id": "11111111-0000-0000-0024-000000004027",
      "book_id": 24,
      "book_name": "إرميا",
      "chapter_num": 4,
      "verse_num": 27,
      "ar_word_position": 5,
      "ar_word": "«",
      "text_original": "כִּי־כֹה֙ אָמַ֣ר יְהוָ֔ה שְׁמָמָ֥ה תִהְיֶ֖ה כָּל־הָאָ֑רֶץ וְכָלָ֖ה לֹ֥א אֶעֱשֶֽׂה׃"
    },
    {
      "id": "0202bacf-3fc4-4861-a0b7-ea27f572a57f",
      "verse_id": "11111111-0000-0000-0024-000000040015",
      "book_id": 24,
      "book_name": "إرميا",
      "chapter_num": 40,
      "verse_num": 15,
      "ar_word_position": 10,
      "ar_word": "«",
      "text_original": "וְיֹוחָנָ֣ן בֶּן־קָרֵ֡חַ אָמַ֣ר אֶל־גְּדַלְיָהוּ֩ בַסֵּ֨תֶר בַּמִּצְפָּ֜ה לֵאמֹ֗ר אֵ֤לְכָה נָּא֙ וְאַכֶּה֙ אֶת־יִשְׁמָעֵ֣אל בֶּן־נְתַנְיָ֔ה וְאִ֖ישׁ לֹ֣א יֵדָ֑ע לָ֧מָּה יַכֶּ֣כָּה נֶּ֗פֶשׁ וְנָפֹ֙צוּ֙ כָּל־יְהוּדָ֔ה הַנִּקְבָּצִ֣ים אֵלֶ֔יךָ וְאָבְדָ֖ה שְׁאֵרִ֥ית יְהוּדָֽה׃"
    },
    {
      "id": "672c217b-388b-4e43-a02c-6dcdc411a59c",
      "verse_id": "11111111-0000-0000-0024-000000042013",
      "book_id": 24,
      "book_name": "إرميا",
      "chapter_num": 42,
      "verse_num": 13,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "וְאִם־אֹמְרִ֣ים אַתֶּ֔ם לֹ֥א נֵשֵׁ֖ב בָּאָ֣רֶץ הַזֹּ֑את לְבִלְתִּ֣י שְׁמֹ֔עַ בְּקֹ֖ול יְהוָ֥ה אֱלֹהֵיכֶֽם׃"
    },
    {
      "id": "3f7d0a34-75ff-4086-b2b0-8f9493bece12",
      "verse_id": "11111111-0000-0000-0024-000000051001",
      "book_id": 24,
      "book_name": "إرميا",
      "chapter_num": 51,
      "verse_num": 1,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "כֹּ֚ה אָמַ֣ר יְהוָ֔ה הִנְנִי֙ מֵעִ֣יר עַל־בָּבֶ֔ל וְאֶל־יֹשְׁבֵ֖י לֵ֣ב קָמָ֑י ר֖וּחַ מַשְׁחִֽית׃"
    },
    {
      "id": "6a118624-29b3-4a26-8979-e52c3b60f501",
      "verse_id": "11111111-0000-0000-0024-000000051041",
      "book_id": 24,
      "book_name": "إرميا",
      "chapter_num": 51,
      "verse_num": 41,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "אֵ֚יךְ נִלְכְּדָ֣ה שֵׁשַׁ֔ךְ וַתִּתָּפֵ֖שׂ תְּהִלַּ֣ת כָּל־הָאָ֑רֶץ אֵ֣יךְ הָיְתָ֧ה לְשַׁמָּ֛ה בָּבֶ֖ל בַּגֹּויִֽם׃"
    },
    {
      "id": "f7888305-7b96-4db1-a77f-3b8cedbcc14a",
      "verse_id": "11111111-0000-0000-0026-000000039025",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 39,
      "verse_num": 25,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "לָכֵ֗ן כֹּ֤ה אָמַר֙ אֲדֹנָ֣י יְהוִ֔ה עַתָּ֗ה אָשִׁיב֙ אֶת־ [שְׁבִית כ] (שְׁב֣וּת ק) יַֽעֲקֹ֔ב וְרִֽחַמְתִּ֖י כָּל־בֵּ֣ית יִשְׂרָאֵ֑ל וְקִנֵּאתִ֖י לְשֵׁ֥ם קָדְשִֽׁי׃"
    },
    {
      "id": "8cc57ec5-dc70-4d2f-9b4b-0dc5f2029e00",
      "verse_id": "11111111-0000-0000-0026-000000044009",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 44,
      "verse_num": 9,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "כֹּה אָמַר֮ אֲדֹנָ֣י יְהוִה֒ כָּל בֶּן נֵכָ֗ר עֶ֤רֶל לֵב֙ וְעֶ֣רֶל בָּשָׂ֔ר לֹ֥א יָב֖וֹא אֶל מִקְדָּשִׁ֑י לְכָל בֶּן נֵכָ֔ר אֲשֶׁ֕ר בְּת֖וֹךְ בְּנֵ֥י יִשְׂרָאֵֽל׃"
    },
    {
      "id": "209a51bb-a82e-4ef3-8829-9ba94b25e850",
      "verse_id": "11111111-0000-0000-0026-000000045009",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 45,
      "verse_num": 9,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "כֹּֽה אָמַ֞ר אֲדֹנָ֣י יְהוִ֗ה רַב לָכֶם֙ נְשִׂיאֵ֣י יִשְׂרָאֵ֔ל חָמָ֤ס וָשֹׁד֙ הָסִ֔ירוּ וּמִשְׁפָּ֥ט וּצְדָקָ֖ה עֲשׂ֑וּ הָרִ֤ימוּ גְרֻשֹֽׁתֵיכֶם֙ מֵעַ֣ל עַמִּ֔י נְאֻ֖ם אֲדֹנָ֥י יְהוִֽה׃"
    },
    {
      "id": "5db8b7ee-6727-4f57-a2ad-6a82f94e6a79",
      "verse_id": "11111111-0000-0000-0026-000000045013",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 45,
      "verse_num": 13,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "זֹ֥את הַתְּרוּמָ֖ה אֲשֶׁ֣ר תָּרִ֑ימוּ שִׁשִּׁ֤ית הָֽאֵיפָה֙ מֵחֹ֣מֶר הַֽחִטִּ֔ים וְשִׁשִּׁיתֶם֙ הָֽאֵיפָ֔ה מֵחֹ֖מֶר הַשְּׂעֹרִֽים׃"
    },
    {
      "id": "ca6c586b-d4b1-4ae6-8626-c75ca8c9eb31",
      "verse_id": "11111111-0000-0000-0026-000000045018",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 45,
      "verse_num": 18,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "כֹּה־אָמַר֮ אֲדֹנָ֣י יְהוִה֒ בָּֽרִאשֹׁון֙ בְּאֶחָ֣ד לַחֹ֔דֶשׁ תִּקַּ֥ח פַּר־בֶּן־בָּקָ֖ר תָּמִ֑ים וְחִטֵּאתָ֖ אֶת־הַמִּקְדָּֽשׁ׃"
    },
    {
      "id": "041ac4bf-1dbe-4ab9-8029-a816611b89e3",
      "verse_id": "11111111-0000-0000-0026-000000046001",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 46,
      "verse_num": 1,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "כֹּֽה אָמַר֮ אֲדֹנָ֣י יְהוִה֒ שַׁ֜עַר הֶחָצֵ֤ר הַפְּנִימִית֙ הַפֹּנֶ֣ה קָדִ֔ים יִהְיֶ֣ה סָג֔וּר שֵׁ֖שֶׁת יְמֵ֣י הַֽמַּעֲשֶׂ֑ה וּבְי֤וֹם הַשַּׁבָּת֙ יִפָּתֵ֔חַ וּבְי֥וֹם הַחֹ֖דֶשׁ יִפָּתֵֽחַ׃"
    },
    {
      "id": "eb4d928f-0c6a-418e-b425-349fe45cee2a",
      "verse_id": "11111111-0000-0000-0026-000000046016",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 46,
      "verse_num": 16,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "כֹּה אָמַ֞ר אֲדֹנָ֣י יְהֹוִ֗ה כִּֽי יִתֵּ֨ן הַנָּשִׂ֤יא מַתָּנָה֙ לְאִ֣ישׁ מִבָּנָ֔יו נַחֲלָת֥וֹ הִ֖יא לְבָנָ֣יו תִּֽהְיֶ֑ה אֲחֻזָּתָ֥ם הִ֖יא בְּנַחֲלָֽה׃"
    },
    {
      "id": "ebb5bc3a-5e07-4441-a0ad-18cd0b5f453d",
      "verse_id": "11111111-0000-0000-0026-000000047013",
      "book_id": 26,
      "book_name": "حزقيال",
      "chapter_num": 47,
      "verse_num": 13,
      "ar_word_position": 1,
      "ar_word": "«",
      "text_original": "כֹּ֤ה אָמַר֙ אֲדֹנָ֣י יְהוִ֔ה גֵּ֤ה גְבוּל֙ אֲשֶׁ֣ר תִּתְנַחֲל֣וּ אֶת־הָאָ֔רֶץ לִשְׁנֵ֥י עָשָׂ֖ר שִׁבְטֵ֣י יִשְׂרָאֵ֑ל יֹוסֵ֖ף חֲבָלִֽים׃"
    }
  ]
}